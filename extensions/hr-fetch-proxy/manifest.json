{
  "manifest_version": 3,
  "name": "auto-qb HR 取数代理",
  "version": "1.0.0",
  "description": "哑取数器: 按本地端点下发的清单, 在后台标签页取 HR 统计页 / 取 .torrent 并回传。不读、不传 cookie, 不做任何解析与频控判断。",
  "minimum_chrome_version": "116",
  "permissions": [
    "alarms",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "auto-qb HR 取数代理"
  }
}
